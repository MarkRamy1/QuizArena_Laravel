# ========================================================
# QuizArena ULTRA — Production Environment Template
# ========================================================

APP_NAME="QuizArena ULTRA"
APP_ENV=production
APP_KEY=base64:ZCMQD55lX6ZKbpxPZPdyvwpc+AWNDuF0UR8SdHA9e44=
APP_DEBUG=false
APP_URL=https://your-production-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --------------------------------------------------------
# Database Configuration
# --------------------------------------------------------
# For Railway / Render / TiDB / Aiven MySQL:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quizarena
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# If your platform provides a single connection URL (e.g., Railway MYSQL_URL or Supabase/Aiven):
# DB_URL=mysql://user:pass@host:port/dbname

# --------------------------------------------------------
# Storage & Driver Settings
# --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --------------------------------------------------------
# Deployment Automation Flags
# --------------------------------------------------------
# Automatically run migrations on deploy
RUN_MIGRATIONS=true

# Automatically seed initial demo accounts (Student, Teacher, Admin, Quizzes) on first run
RUN_DB_SEED=true
